{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RenderNorth Industrial",
  "version": "0.1.2",
  "identifier": "com.rendernorth.industrial",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RenderNorth Industrial",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "shortDescription": "Local-first EVE Online industrial intelligence",
    "longDescription": "RenderNorth Industrial provides local-first inventory, production, market, procurement, and doctrine intelligence using CCP-authorized read-only data.",
    "copyright": "Copyright © 2026 RenderNorth",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
